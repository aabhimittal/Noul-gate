{
  "$defs": {
    "Decision": {
      "enum": [
        "allow",
        "ask",
        "deny"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One line of the JSONL audit log. Every pending tool call produces exactly one record.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "source": {
      "default": "claude_code_hook",
      "enum": [
        "claude_code_hook",
        "mcp_proxy",
        "serve"
      ],
      "title": "Source",
      "type": "string"
    },
    "mode": {
      "default": "log",
      "enum": [
        "log",
        "enforce"
      ],
      "title": "Mode",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "tool_use_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Use Id"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_input": {
      "additionalProperties": true,
      "title": "Tool Input",
      "type": "object"
    },
    "tool_input_truncated": {
      "default": false,
      "title": "Tool Input Truncated",
      "type": "boolean"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwd"
    },
    "permission_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permission Mode"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "emitted": {
      "default": "none",
      "enum": [
        "none",
        "allow",
        "ask",
        "deny"
      ],
      "title": "Emitted",
      "type": "string"
    },
    "p_harm": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P Harm"
    },
    "risk_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk Class"
    },
    "answers": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answers"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "policy_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Id"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "tool_name"
  ],
  "title": "AuditRecord",
  "type": "object"
}
